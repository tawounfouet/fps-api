ENVIRONMENT=development
SERVICE_NAME=fps-platform-api
API_NAME=FPS Content Platform API
API_VERSION=1.0.0
RELEASE_SHA=local
DEBUG=false
DOCS_ENABLED=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

DATABASE_URL=postgresql+psycopg://fps:replace-with-local-password@localhost:5432/fps
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=2

OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256"]
OIDC_JWKS_CACHE_TTL_SECONDS=300
OIDC_CLOCK_LEEWAY_SECONDS=30

CONTACT_RATE_LIMIT_PER_WINDOW=5
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_MAX_BODY_BYTES=16384
CONTACT_TRUSTED_PROXY_COUNT=0
CONTACT_EMAIL_PROVIDER_MODE=mock
CONTACT_EMAIL_PROVIDER=mock
CONTACT_EMAIL_TEMPLATE_CODE=contact_request
CONTACT_EMAIL_RECIPIENT_GROUP_CODE=contact_team
CONTACT_DELIVERY_MAX_ATTEMPTS=5
CONTACT_DELIVERY_RETRY_DELAYS_SECONDS=[60,300,1500,7200]
CONTACT_WORKER_LEASE_SECONDS=60
CONTACT_WORKER_BATCH_SIZE=20

RESEND_API_KEY=replace-with-isolated-resend-sandbox-key
RESEND_BASE_URL=https://api.example.test
EMAIL_REQUEST_TIMEOUT_SECONDS=10
SENDER_EMAIL=sender@example.test
NOTIFY_EMAIL=notify@example.test
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=replace-with-smtp-user
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_SSL=true
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USER=replace-with-imap-user
IMAP_PASSWORD=replace-with-imap-password
IMAP_USE_SSL=true
